        "tags": [
          "Sistema"
        ],
        "summary": "Verificación de salud del servicio",
        "description": "Retorna el estado de salud del servicio.\nEste endpoint no requiere autenticación.",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Estado operativo del servicio",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
