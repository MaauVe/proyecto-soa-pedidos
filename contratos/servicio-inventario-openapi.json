{
  "openapi": "3.1.0",
  "info": {
    "title": "Servicio de Catálogo e Inventario",
    "description": "API REST para la gestión del catálogo de productos y control de existencias. Permite registrar, consultar, actualizar y desactivar productos, así como realizar reservas atómicas y liberación de stock para la orquestación de pedidos.",
    "version": "0.1.0"
  },
  "paths": {
