            "description": "Descripción opcional del producto"
          },
          "unit_price": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Unit Price",
            "description": "Precio unitario (debe ser mayor a cero)"
          },
          "weight_kg": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Weight Kg",
            "description": "Peso en kg para cálculo de envío (mayor a cero)"
          },
          "stock": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Stock",
            "description": "Existencias disponibles (entero mayor o igual a cero)"
          }
        },
