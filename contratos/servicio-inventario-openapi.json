      "get": {
        "tags": [
          "Sistema"
        ],
        "summary": "Verificación de salud del servicio",
        "description": "Retorna el estado de salud del servicio.\nEste endpoint es público y no requiere autenticación por X-API-Key.",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Estado operativo del servicio",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
