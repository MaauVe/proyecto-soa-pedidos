          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "shipping_cost": {
            "type": "number",
            "title": "Shipping Cost"
          },
          "total_amount": {
            "type": "number",
            "title": "Total Amount"
          },
          "shipment_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Shipment Id"
          },
          "shipment_status": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Shipment Status"
          },
          "shipment_detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Shipment Detail"
          },
          "compensation_error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Compensation Error"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
