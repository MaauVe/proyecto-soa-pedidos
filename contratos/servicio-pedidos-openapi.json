          },
          "quantity": {
            "type": "integer",
            "title": "Quantity"
          },
          "subtotal": {
            "type": "number",
            "title": "Subtotal"
          }
        },
        "type": "object",
        "required": [
          "id",
          "product_id",
          "product_name",
          "unit_price",
          "quantity",
          "subtotal"
        ],
        "title": "OrderItemResponse"
      },
      "OrderListResponse": {
        "properties": {
          "items": {
            "items": {
