{
  "openapi": "3.1.0",
  "info": {
    "title": "Servicio Orquestador de Pedidos",
    "description": "API REST del orquestador del sistema SOA de pedidos y entregas. Coordina por HTTP la validación de clientes, reserva y liberación de inventario (Saga), cotización y despacho de envíos, y persiste el estado canónico de los pedidos.",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Salud"
        ],
        "summary": "Verificar estado de salud del servicio",
        "description": "Endpoint público sin autenticación para monitoreo de disponibilidad.",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/orders": {
      "post": {
        "tags": [
          "Pedidos"
        ],
        "summary": "Crear nuevo pedido (Flujo Orquestado + Saga)",
        "description": "Orquesta la creación de un pedido en 5 pasos: 1) Valida cliente en servicio-clientes; 2) Reserva stock en servicio-inventario; 3) Cotiza envío en servicio-envios; 4) Persiste el pedido y líneas en SQLite; 5) Registra la guía de envío en servicio-envios. Si ocurre un fallo tras reservar stock, compensa automáticamente liberando el inventario.",
        "operationId": "create_order_orders_post",
        "parameters": [
          {
            "name": "X-API-Key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Clave de autenticación requerida en todos los endpoints protegidos.",
              "title": "X-Api-Key"
            },
            "description": "Clave de autenticación requerida en todos los endpoints protegidos."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OrderCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Pedidos"
        ],
        "summary": "Listado paginado de pedidos",
        "description": "Retorna el listado paginado de pedidos persistidos en pedidos.db con filtros opcionales.",
        "operationId": "list_orders_orders_get",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "description": "Número de página (>= 1)",
              "default": 1,
              "title": "Page"
            },
            "description": "Número de página (>= 1)"
          },
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "description": "Cantidad por página (1 a 100)",
              "default": 20,
              "title": "Page Size"
            },
            "description": "Cantidad por página (1 a 100)"
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filtrar por estado del pedido",
              "title": "Status"
            },
            "description": "Filtrar por estado del pedido"
          },
          {
            "name": "customer_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filtrar por cliente",
              "title": "Customer Id"
            },
            "description": "Filtrar por cliente"
          },
          {
            "name": "X-API-Key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Clave de autenticación requerida en todos los endpoints protegidos.",
              "title": "X-Api-Key"
            },
            "description": "Clave de autenticación requerida en todos los endpoints protegidos."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderListResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/orders/{order_id}": {
      "get": {
        "tags": [
          "Pedidos"
        ],
        "summary": "Consultar pedido por ID con estado de envío enriquecido",
        "description": "Retorna la información completa de un pedido con sus líneas. Consulta el estado en tiempo real en servicio-envios. Si el servicio de envíos no responde, retorna la respuesta degradada con shipment_status: null y aviso explicativo.",
        "operationId": "get_order_orders__order_id__get",
        "parameters": [
          {
            "name": "order_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Order Id"
            }
          },
          {
            "name": "X-API-Key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Clave de autenticación requerida en todos los endpoints protegidos.",
              "title": "X-Api-Key"
            },
            "description": "Clave de autenticación requerida en todos los endpoints protegidos."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/orders/{order_id}/cancel": {
      "patch": {
        "tags": [
          "Pedidos"
        ],
        "summary": "Cancelar pedido activo",
        "description": "Cancela un pedido activo verificando el estado del envío en servicio-envios. Si el envío está en PENDING, cancela el envío, libera el inventario y marca el pedido como CANCELLED. Si está en IN_TRANSIT o DELIVERED, rechaza con 409.",
        "operationId": "cancel_order_orders__order_id__cancel_patch",
        "parameters": [
          {
            "name": "order_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Order Id"
            }
          },
          {
            "name": "X-API-Key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Clave de autenticación requerida en todos los endpoints protegidos.",
              "title": "X-Api-Key"
            },
            "description": "Clave de autenticación requerida en todos los endpoints protegidos."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "service": {
            "type": "string",
            "title": "Service",
            "description": "Nombre del servicio",
            "default": "servicio-pedidos"
          },
          "status": {
            "type": "string",
            "title": "Status",
            "description": "Estado operativo",
            "default": "ok"
          },
          "version": {
            "type": "string",
            "title": "Version",
            "description": "Versión del servicio",
            "default": "0.1.0"
          },
          "port": {
            "type": "integer",
            "title": "Port",
            "description": "Puerto configurado",
            "default": 8004
          }
        },
        "type": "object",
        "title": "HealthResponse"
      },
      "OrderCreate": {
        "properties": {
          "customer_id": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Customer Id",
            "description": "ID del cliente que realiza el pedido"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/OrderItemIn"
            },
            "type": "array",
            "minItems": 1,
            "title": "Items",
            "description": "Lista de productos a ordenar"
          }
        },
        "type": "object",
        "required": [
          "customer_id",
          "items"
        ],
        "title": "OrderCreate"
      },
      "OrderItemIn": {
        "properties": {
          "product_id": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Product Id",
            "description": "ID del producto"
          },
          "quantity": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Quantity",
            "description": "Cantidad a ordenar (mínimo 1)"
          }
        },
        "type": "object",
        "required": [
          "product_id",
          "quantity"
        ],
        "title": "OrderItemIn"
      },
      "OrderItemResponse": {
        "properties": {
          "id": {
            "type": "integer",
