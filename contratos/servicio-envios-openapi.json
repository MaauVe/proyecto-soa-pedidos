{
  "openapi": "3.1.0",
  "info": {
    "title": "Servicio de Envíos",
    "description": "Cotización de tarifas y gestión del ciclo de vida de entregas para el sistema SOA de pedidos.",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Salud"
        ],
        "summary": "Verificar estado de salud del servicio",
        "description": "Endpoint público sin autenticación para monitoreo de disponibilidad.",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/zones": {
      "get": {
        "tags": [
          "Zonas"
        ],
        "summary": "Consultar zonas disponibles",
        "description": "Retorna la lista de zonas de envío soportadas con sus tarifas planas vigentes.",
        "operationId": "get_zones_zones_get",
        "parameters": [
          {
            "name": "X-API-Key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Clave de autenticación requerida en todos los endpoints protegidos.",
              "title": "X-Api-Key"
            },
            "description": "Clave de autenticación requerida en todos los endpoints protegidos."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ZoneInfo"
                  },
                  "title": "Response Get Zones Zones Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/quote": {
      "post": {
        "tags": [
          "Cotización"
        ],
        "summary": "Cotizar costo de envío por zona",
        "description": "Calcula la tarifa plana de envío según la zona de destino solicitada.",
        "operationId": "quote_shipping_quote_post",
        "parameters": [
          {
            "name": "X-API-Key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Clave de autenticación requerida en todos los endpoints protegidos.",
              "title": "X-Api-Key"
            },
            "description": "Clave de autenticación requerida en todos los endpoints protegidos."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QuoteRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuoteResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/shipments": {
      "post": {
        "tags": [
          "Envíos"
        ],
        "summary": "Crear nuevo registro de envío",
        "description": "Crea un envío para un pedido en estado inicial PENDING con la tarifa vigente de la zona.",
        "operationId": "create_shipment_shipments_post",
        "parameters": [
          {
            "name": "X-API-Key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Clave de autenticación requerida en todos los endpoints protegidos.",
              "title": "X-Api-Key"
            },
            "description": "Clave de autenticación requerida en todos los endpoints protegidos."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ShipmentCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShipmentResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Envíos"
        ],
        "summary": "Listar envíos con paginación y filtros",
        "description": "Retorna una lista paginada de envíos con filtros opcionales por status y order_id.",
        "operationId": "list_shipments_shipments_get",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "description": "Número de página",
              "default": 1,
              "title": "Page"
            },
            "description": "Número de página"
          },
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "description": "Cantidad de registros por página",
              "default": 20,
              "title": "Page Size"
            },
            "description": "Cantidad de registros por página"
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/StatusEnum"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filtrar por estado del envío",
              "title": "Status"
            },
            "description": "Filtrar por estado del envío"
          },
          {
            "name": "order_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filtrar por ID de pedido",
              "title": "Order Id"
            },
            "description": "Filtrar por ID de pedido"
          },
          {
            "name": "X-API-Key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Clave de autenticación requerida en todos los endpoints protegidos.",
              "title": "X-Api-Key"
            },
            "description": "Clave de autenticación requerida en todos los endpoints protegidos."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShipmentListResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/shipments/{id}": {
      "get": {
        "tags": [
          "Envíos"
        ],
        "summary": "Consultar envío por ID",
        "description": "Obtiene el detalle completo y estado actual de un envío.",
        "operationId": "get_shipment_shipments__id__get",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "description": "Identificador único del envío",
              "title": "Id"
            },
            "description": "Identificador único del envío"
          },
          {
            "name": "X-API-Key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Clave de autenticación requerida en todos los endpoints protegidos.",
              "title": "X-Api-Key"
            },
            "description": "Clave de autenticación requerida en todos los endpoints protegidos."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShipmentResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/shipments/{id}/status": {
      "patch": {
        "tags": [
          "Envíos"
        ],
        "summary": "Actualizar estado del envío",
        "description": "Avanza el estado del envío según las transiciones permitidas por la máquina de estados.",
        "operationId": "update_shipment_status_shipments__id__status_patch",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "description": "Identificador único del envío",
              "title": "Id"
            },
            "description": "Identificador único del envío"
          },
          {
            "name": "X-API-Key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Clave de autenticación requerida en todos los endpoints protegidos.",
              "title": "X-Api-Key"
            },
            "description": "Clave de autenticación requerida en todos los endpoints protegidos."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StatusUpdateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShipmentResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "description": "Estado del servicio",
            "examples": [
              "ok"
            ]
          },
          "service": {
            "type": "string",
            "title": "Service",
            "description": "Nombre del servicio",
            "examples": [
              "servicio-envios"
            ]
          },
          "version": {
            "type": "string",
            "title": "Version",
            "description": "Versión del servicio",
            "examples": [
              "0.1.0"
            ]
          },
          "port": {
            "type": "integer",
            "title": "Port",
            "description": "Puerto de escucha",
            "examples": [
              8003
            ]
          }
        },
        "type": "object",
        "required": [
          "status",
          "service",
          "version",
          "port"
        ],
        "title": "HealthResponse"
      },
      "QuoteRequest": {
        "properties": {
          "zone": {
            "$ref": "#/components/schemas/ZoneEnum",
            "description": "Zona de destino a cotizar"
          }
        },
        "type": "object",
        "required": [
          "zone"
        ],
        "title": "QuoteRequest"
      },
      "QuoteResponse": {
        "properties": {
          "zone": {
            "$ref": "#/components/schemas/ZoneEnum",
            "description": "Zona cotizada"
          },
          "shipping_cost": {
            "type": "number",
            "minimum": 0.0,
            "title": "Shipping Cost",
            "description": "Costo de envío calculado"
          }
        },
        "type": "object",
        "required": [
          "zone",
          "shipping_cost"
        ],
        "title": "QuoteResponse"
      },
      "ShipmentCreate": {
        "properties": {
          "order_id": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Order Id",
            "description": "ID del pedido asociado en servicio-pedidos"
          },
          "zone": {
            "$ref": "#/components/schemas/ZoneEnum",
            "description": "Zona de destino del envío"
          },
          "recipient_name": {
            "type": "string",
            "minLength": 1,
            "title": "Recipient Name",
            "description": "Nombre del destinatario"
          }
        },
        "type": "object",
        "required": [
          "order_id",
          "zone",
          "recipient_name"
        ],
        "title": "ShipmentCreate"
      },
      "ShipmentListResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ShipmentResponse"
            },
            "type": "array",
            "title": "Items",
            "description": "Lista de envíos"
          },
          "total": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Total",
            "description": "Total de envíos encontrados"
          },
          "page": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Page",
            "description": "Número de página actual"
          },
          "page_size": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Page Size",
            "description": "Tamaño de página"
          }
        },
        "type": "object",
        "required": [
          "items",
          "total",
          "page",
          "page_size"
        ],
        "title": "ShipmentListResponse"
      },
      "ShipmentResponse": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id",
            "description": "Identificador único del envío"
          },
          "order_id": {
            "type": "integer",
            "title": "Order Id",
            "description": "ID del pedido asociado"
          },
          "zone": {
            "$ref": "#/components/schemas/ZoneEnum",
            "description": "Zona de destino"
          },
          "recipient_name": {
            "type": "string",
            "title": "Recipient Name",
            "description": "Nombre del destinatario"
          },
          "shipping_cost": {
            "type": "number",
            "minimum": 0.0,
            "title": "Shipping Cost",
            "description": "Costo del envío"
          },
          "status": {
            "$ref": "#/components/schemas/StatusEnum",
            "description": "Estado actual del envío"
          },
          "created_at": {
            "type": "string",
            "title": "Created At",
            "description": "Fecha y hora de creación ISO-8601"
          },
          "updated_at": {
            "type": "string",
            "title": "Updated At",
            "description": "Fecha y hora de última actualización ISO-8601"
          }
        },
        "type": "object",
        "required": [
          "id",
          "order_id",
          "zone",
          "recipient_name",
          "shipping_cost",
          "status",
          "created_at",
          "updated_at"
        ],
        "title": "ShipmentResponse"
      },
      "StatusEnum": {
        "type": "string",
        "enum": [
          "PENDING",
          "IN_TRANSIT",
          "DELIVERED",
          "CANCELLED"
        ],
        "title": "StatusEnum"
      },
      "StatusUpdateRequest": {
        "properties": {
          "new_status": {
            "$ref": "#/components/schemas/StatusEnum",
            "description": "Nuevo estado del envío"
          }
        },
        "type": "object",
        "required": [
          "new_status"
        ],
        "title": "StatusUpdateRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "ZoneEnum": {
        "type": "string",
        "enum": [
          "LOCAL",
          "REGIONAL",
          "NACIONAL"
        ],
        "title": "ZoneEnum"
      },
      "ZoneInfo": {
        "properties": {
          "zone": {
            "$ref": "#/components/schemas/ZoneEnum",
            "description": "Nombre de la zona de destino"
          },
          "rate": {
            "type": "number",
            "minimum": 0.0,
            "title": "Rate",
            "description": "Tarifa plana de envío para la zona"
          }
        },
        "type": "object",
        "required": [
          "zone",
          "rate"
        ],
        "title": "ZoneInfo"
      }
    }
  }
}