# .env.example — Copiar como .env y ajustar valores locales
# NUNCA commitear el archivo .env real

# ── Puertos de cada servicio ──────────────────────────────────────────────────
PORT_CLIENTES=8001
PORT_INVENTARIO=8002
PORT_ENVIOS=8003
PORT_PEDIDOS=8004

# ── URLs base de los servicios (usadas por el orquestador y el frontend) ──────
URL_CLIENTES=http://localhost:8001
URL_INVENTARIO=http://localhost:8002
URL_ENVIOS=http://localhost:8003
URL_PEDIDOS=http://localhost:8004

# ── Seguridad ─────────────────────────────────────────────────────────────────
# Cambiar esta clave antes de cualquier despliegue real
API_KEY=changeme-local-key

# ── Base de datos (rutas relativas a cada carpeta de servicio) ────────────────
DB_CLIENTES=clientes.db
DB_INVENTARIO=inventario.db
DB_ENVIOS=envios.db
DB_PEDIDOS=pedidos.db

# ── Tarifas planas de envío (servicio-envios) ─────────────────────────────────
RATE_LOCAL=50
RATE_REGIONAL=100
RATE_NACIONAL=200

# ── Configuración general ─────────────────────────────────────────────────────
DEBUG=true
LOG_LEVEL=info
HTTP_TIMEOUT_SECONDS=10
